pipeline {
    agent any

    stages {
        stage('preparation') {
            steps {
                // Get some code from a GitHub repository
                git branch: 'main', url: 'https://github.com/bashar3223/node-js.git'
            }
        }    
        stage('ci') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', passwordVariable: 'PASSWORD', usernameVariable: 'USERNAME')]) {
                    sh(" docker build -t bashar/iti3monjenkins .") 
                    sh("docker login -u ${USERNAME} -p ${PASSWORD}")
                    sh("docker push bashar/iti3monjenkins")
                }
            }
        }
        stage('cd') {
            steps {
                sh "docker run -d -p 3000:3000 bashar/iti3monjenkins"
            }
        }
    }
}
